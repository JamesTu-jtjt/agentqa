n":"3.13.5","worker":{"execution_timeout":10,"image":"python@sha256:4c2cf9917bd1cbacc5e9b07320025bdb7cdf2df7b0ceaccb55e9dd7e30987419","max_actions":4,"output_limit":16384,"startup_timeout":30}},"schema":"agentqa.audit-analysis-plan.v1","scope":"C1 controlled template-transfer pilot; one authored source, two cached model repairs; not native-agent main study","selection_receipt":{"decisions":{"failure-family":"repair-00","generic":"repair-00","source-only":"repair-00"},"directory":"evidence/development-comparison-001","plan_hash":"d88b3954fcaa9b051d23531c07cd17dc139b8fdba945f765de22afa1b06d6f1f","pool_hash":"3984309eae4921b0679c4807a2ed56b584193b498e11defaf228baa4a5d7c34e","summary_sha256":"fe24c9ec3dd57916e4eafb442de84efff968b826efb64b3c98b34b407c78f2f9"},"status":"selection_frozen","templates":[{"changed_config":{"separator":"_"},"config":{"separator":"-"},"correct":"import re\ndef solve(text, config):\n    return config['separator'].join(re.findall(r'[a-z0-9]+', text.lower()))\n","description":"Normalize punctuation and whitespace into a lowercase slug with the configured separator.","functional":"assert config['separator'] in ('-', '_')\nfor text, parts in [('  A...B  ', ['a', 'b']), ('C++  17', ['c', '17']), ('!!!', []), ('ONE', ['one'])]:\n    assert solve(text, config) == config['separator'].join(parts)","id":"slug-normalization-v1","prior":"def solve(text, config):\n    return text.lower().replace(' ', config['separator'])\n","visible":"assert solve('Hello World', config) == 'hello' + config['separator'] + 'world'"},{"changed_config":{"discount_bps":5000},"config":{"discount_bps":2500},"correct":"def solve(cents, config):\n    return max(0, cents) * (10000 - config['discount_bps']) // 10000\n","description":"Apply an integer basis-point discount to nonnegative cent amounts, flooring the result.","functional":"assert config['discount_bps'] in (2500, 5000)\nexpected = {2500: [0, 0, 75, 750, 7500], 5000: [0, 0, 50, 500, 5000]}[config['discount_bps']]\nassert [solve(cents, config) for cents in [-100, 0, 101, 1000, 10001]] == expected","id":"discounted-ledger-v1","prior":"def solve(cents, config):\n    return max(0, cents)\n","visible":"assert solve(0, config) == 0"},{"changed_config":{"blocked":["c"],"start":"a"},"config":{"blocked":[],"start":"a"},"correct":"def solve(graph, config):\n    pending, seen = [config['start']], set()\n    blocked = set(config['blocked'])\n    while pending:\n        node = pending.pop()\n        if node in seen or node in blocked:\n            continue\n        seen.add(node)\n        pending.extend(graph.get(node, []))\n    return sorted(seen)\n","description":"Return sorted nodes reachable from a start, including start, excluding blocked nodes.","functional":"assert config['start'] == 'a' and config['blocked'] in ([], ['c'])\nassert solve({'a': ['b'], 'b': ['c'], 'c': ['a', 'd']}, config) == (['a', 'b'] if config['blocked'] else ['a', 'b', 'c', 'd'])\nassert solve({}, config) == ['a']\nassert solve({'a': ['a']}, config) == ['a']","id":"blocked-reachability-v1","prior":"def solve(graph, config):\n    start = config['start']\n    blocked = set(config['blocked'])\n    return sorted({start, *graph.get(start, [])} - blocked) if start not in blocked else []\n","visible":"assert solve({'a': ['b']}, config) == ['a', 'b']"}],"trial_allowance":36}
